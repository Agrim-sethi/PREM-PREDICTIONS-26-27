rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'agrim@prem-predict-2627-agrim.firebaseapp.com';
    }

    function isPlayer(player) {
      return signedIn() && (
        (request.auth.token.email == 'samarth@prem-predict-2627-agrim.firebaseapp.com' && player == 'Samarth') ||
        (request.auth.token.email == 'dhairya@prem-predict-2627-agrim.firebaseapp.com' && player == 'Dhairya') ||
        (request.auth.token.email == 'luvi@prem-predict-2627-agrim.firebaseapp.com' && player == 'Luvi') ||
        (request.auth.token.email == 'claude@prem-predict-2627-agrim.firebaseapp.com' && player == 'Claude')
      );
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /cards/{cardId} {
      allow read: if signedIn();

      // Card plays are immutable slot documents. A normal player can create
      // only their own card play (player name bound to auth email), with
      // createdByUid matching their UID. The slot must not already exist.
      allow create: if isAdmin() || (
        isPlayer(request.resource.data.player) &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.id == cardId &&
        request.resource.data.slotId == cardId &&
        !exists(/databases/$(database)/documents/cards/$(cardId))
      );

      // Players never edit an existing card play. Admin alone can correct or delete.
      allow update, delete: if isAdmin();
    }

    match /predictions/{predictionId} {
      allow read: if signedIn();
      allow create: if isAdmin() || isPlayer(request.resource.data.player);
      allow update: if isAdmin() || (
        isPlayer(request.resource.data.player) &&
        resource.data.player == request.resource.data.player
      );
      allow delete: if isAdmin();
    }
  }
}
