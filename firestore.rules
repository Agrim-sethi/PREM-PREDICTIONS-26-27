rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'agrim@prem-predict-2627-agrim.firebaseapp.com';
    }

    function isPlayer(player) {
      return signedIn() && (
        (request.auth.token.email == 'samarth@prem-predict-2627-agrim.firebaseapp.com' && player == 'Samarth') ||
        (request.auth.token.email == 'dhairya@prem-predict-2627-agrim.firebaseapp.com' && player == 'Dhairya') ||
        (request.auth.token.email == 'luvi@prem-predict-2627-agrim.firebaseapp.com' && player == 'Luvi') ||
        (request.auth.token.email == 'claude@prem-predict-2627-agrim.firebaseapp.com' && player == 'Claude')
      );
    }

    // Resolve the gameweek for a prediction from its referenced match.
    function predictionGW() {
      return get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.gw;
    }

    // Missing lock document means the GW is OPEN. A true value means LOCKED.
    function predictionOpen() {
      return !exists(/databases/$(database)/documents/gameweeks/gw$(predictionGW())) ||
        get(/databases/$(database)/documents/gameweeks/gw$(predictionGW())).data.locked != true;
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Per-GW prediction lock state. Everyone can read it; only admin can change it.
    match /gameweeks/{gwId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /cards/{cardId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (
        isPlayer(request.resource.data.player) &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.id == cardId &&
        request.resource.data.slotId == cardId &&
        !exists(/databases/$(database)/documents/cards/$(cardId))
      );
      allow update, delete: if isAdmin();
    }

    match /predictions/{predictionId} {
      allow read: if signedIn();

      // Admin can always create a prediction, even while the GW is locked.
      allow create: if isAdmin() || (
        isPlayer(request.resource.data.player) &&
        predictionOpen()
      );

      // Players can only modify their own prediction while that GW remains open.
      // Admin can always modify predictions.
      allow update: if isAdmin() || (
        isPlayer(request.resource.data.player) &&
        resource.data.player == request.resource.data.player &&
        predictionOpen()
      );

      allow delete: if isAdmin();
    }
  }
}
